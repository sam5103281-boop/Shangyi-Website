{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shangyi-web",
  "main": "./dist/server/index.mjs",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
  },
}